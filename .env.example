# EduExtract AI Configuration Template
# Copy this file to .env and configure as needed.

# Application Settings
APP_ENV=development
DEBUG=True
DATABASE_PATH=data/eduextract.db
MAX_FILE_SIZE_MB=25
MAX_PAGE_COUNT=100

# Optional OCR Settings (requires tesseract binary installed on system)
ENABLE_OCR=False
TESSERACT_CMD=

# Optional Generative LLM Provider (HuggingFace / OpenAI-compatible / Local)
LLM_PROVIDER=local_fallback
OPENAI_API_KEY=
HUGGINGFACE_API_TOKEN=
LOCAL_MODEL_NAME=sshleifer/distilbart-cnn-6-6
